---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Home | Astro Test">
	<section class="mx-auto max-w-5xl px-6 py-20 lg:py-28">
		<p class="mb-4 text-sm font-semibold uppercase tracking-wider text-cyan-300">Home</p>
		<h1 class="max-w-3xl text-5xl font-bold tracking-tight text-white sm:text-6xl">
			Build fast pages with Astro and Tailwind.
		</h1>
		<p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">
			The home page uses the shared layout, so updates to the site frame happen in one place.
		</p>
	</section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Home | Astro Test">
	<section class="mx-auto grid max-w-5xl gap-8 px-6 py-20 lg:grid-cols-[1.15fr_0.85fr] lg:items-center lg:py-28">
		<div>
			<p class="mb-4 text-sm font-semibold uppercase tracking-wider text-cyan-300">Home</p>
			<h1 class="max-w-3xl text-5xl font-bold tracking-tight text-white sm:text-6xl">
				A clean Astro starter with Tailwind ready to go.
			</h1>
			<p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">
				This page now runs through a shared layout with reusable header and footer components.
			</p>
		</div>
		<div class="rounded-lg border border-white/10 bg-white/5 p-6">
			<h2 class="text-xl font-semibold text-white">Project Setup</h2>
			<ul class="mt-5 space-y-3 text-slate-300">
				<li>Astro pages for Home and About</li>
				<li>Shared layout with global metadata</li>
				<li>Reusable navigation and footer components</li>
			</ul>
		</div>
	</section>
</BaseLayout>

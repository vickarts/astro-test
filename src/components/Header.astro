---
const navItems = [
	{ href: '/', label: 'Home' },
	{ href: '/about', label: 'About' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="border-b border-white/10 bg-slate-950/90">
	<nav class="mx-auto flex max-w-5xl items-center justify-between px-6 py-5" aria-label="Main navigation">
		<a class="text-lg font-bold tracking-tight text-white" href="/">Astro Test</a>
		<div class="flex items-center gap-2">
			{
				navItems.map((item) => {
					const itemPath = item.href.replace(/\/$/, '') || '/';
					const isActive = currentPath === itemPath || (currentPath === '/home' && itemPath === '/');

					return (
						<a
							class:list={[
								'rounded-md px-3 py-2 text-sm font-medium transition',
								isActive
									? 'bg-white text-slate-950'
									: 'text-slate-300 hover:bg-white/10 hover:text-white',
							]}
							href={item.href}
							aria-current={isActive ? 'page' : undefined}
						>
							{item.label}
						</a>
					);
				})
			}
		</div>
	</nav>
</header>
